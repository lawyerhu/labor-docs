{
  "name": "labor-docs-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env local",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy --env=\"\"",
    "db:migrate:local": "wrangler d1 migrations apply labor-docs --local",
    "db:migrate:remote": "wrangler d1 migrations apply labor-docs --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.7.2",
    "wrangler": "latest"
  }
}
